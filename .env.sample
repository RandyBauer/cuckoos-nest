# Production settings for The Cuckoo's Nest. Copy to .env (which git ignores) and fill in.
# Nothing here has a default in production: a missing value stops the app at startup.

SPRING_PROFILES_ACTIVE=prod

# PostgreSQL
DATABASE_URL=jdbc:postgresql://your-db-host:5432/nest
DATABASE_USERNAME=nest
DATABASE_PASSWORD=change-me

# Redis
REDIS_HOST=your-redis-host
REDIS_PORT=6379

# Optional: requests per IP per minute on the public tripwires before answering 429 (default 120).
# NEST_TRIPWIRE_REQUESTS_PER_MINUTE=120

# The public address of this Nest, used to build bait URLs. No trailing slash.
NEST_PUBLIC_BASE_URL=https://nest.example.com

# Bearer token AI agents send to /mcp. Make a long random one, for example:
#   openssl rand -base64 32
NEST_MCP_TOKEN=change-me

# Dashboard login. Store only a bcrypt hash of the password, never the password. To make one:
#   docker run --rm httpd:2.4-alpine htpasswd -nbBC 10 admin 'your-password'
# and copy the part after "admin:". In a .env file read by docker compose, write each $ as $$.
NEST_ADMIN_USERNAME=admin
NEST_ADMIN_PASSWORD_HASH=change-me
