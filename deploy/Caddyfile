# Caddy gets and renews a free Let's Encrypt certificate for NEST_HOST on its own,
# redirects http to https, and forwards requests to the app with X-Forwarded-For set.
{$NEST_HOST} {
	encode gzip
	reverse_proxy app:8080
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
